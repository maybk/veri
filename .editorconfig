# 统一编辑器行为的根配置。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Go 官方格式使用制表符缩进，由 gofmt 维护。
[*.go]
indent_style = tab

# 配置、脚本与文档使用 2 空格缩进。
[{*.toml,*.yaml,*.yml,*.json,*.md,*.sh}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf
